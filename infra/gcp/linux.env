# The linux runner type: a CPU-only Cloud Run job, agent-linux, built from
# images/cloud/linux. One file per type; its name is the type. The deploy
# renders the job from it (scripts/cloud/job-spec.sh), and the orchestrator
# image bakes it in for the supervisor and the hook. Non-secret settings only:
# the type's Claude environment key is the Secret Manager secret claude-env-linux.

# Job resources. Scratch is the Cloud Run ephemeral disk mounted at /scratch;
# 10 GiB is the default per-instance quota (no approval needed).
CPU=4
MEMORY=16Gi
SCRATCH_GIB=10

# Cloud Run's hard stop for the execution: the 480 min session cap, plus up to
# 60 min a runner may wait unused, plus margin (9 h 30 min).
TASK_TIMEOUT_SEC=34200
# The runner retires (releases its session cleanly) this long before the hard stop.
RETIRE_MARGIN_SEC=900

# Scheduled no-cache rebuild (specs/gcp.md, "Rebuild cadence"): nightly
# (Tuesday to Saturday) or weekly (Sunday). linux moves with Claude and apt,
# and a cached build takes minutes.
REBUILD=nightly

# Orchestrator settings. No standby: a held 4 vCPU, 16 GiB execution is about
# $270 a month, so sessions wait for a cold start instead.
MIN_IDLE=0
EXPECTED_SPAWN_SECONDS=180

# Runner settings (images/shared/runners/claude.sh). Empty = never.
EXIT_IF_UNUSED_MIN=60
RELEASE_IDLE_SESSION_MIN=60
KILL_SESSION_AFTER_MIN=480

# The session notice shows its end time in this zone.
AGENT_NOTICE_TZ=America/Los_Angeles
