# Terraform's outputs for the lolay-agents project (lolay/infrastructure,
# stacks/gcp/agents), committed as a copy for the workflows and the orchestrator
# image. Terraform is the source: change it there, then copy the new output here.
# Nothing else goes in this file; per-type settings live in infra/gcp/<type>.env.
PROJECT_ID=lolay-agents
PROJECT_NUMBER=613087327945
REGION=us-central1
ZONE=us-central1-a
ARTIFACT_REGISTRY=us-central1-docker.pkg.dev/lolay-agents/agent-images
WIF_PROVIDER=projects/613087327945/locations/global/workloadIdentityPools/github/providers/github-actions
CI_SERVICE_ACCOUNT=agent-images-ci@lolay-agents.iam.gserviceaccount.com
ORCHESTRATOR_SERVICE_ACCOUNT=agent-orchestrator@lolay-agents.iam.gserviceaccount.com
RUNNER_SERVICE_ACCOUNT=agent-runner@lolay-agents.iam.gserviceaccount.com
ORDER_BUCKET=lolay-agents-orders
OUTPUTS_BUCKET=lolay-agents-outputs
DATASETS_BUCKET=lolay-agents-datasets
ORCHESTRATOR_INSTANCE=agent-orchestrator
NETWORK=projects/lolay-agents/global/networks/agents
SUBNET=projects/lolay-agents/regions/us-central1/subnetworks/agents-us-central1
