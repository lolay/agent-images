# The gis runner type: a CPU-only Cloud Run job, agent-gis, built from
# images/cloud/gis. One file per type; its name is the type. The deploy
# renders the job from it (scripts/cloud/job-spec.sh), and the orchestrator
# image bakes it in for the supervisor and the hook. Non-secret settings only:
# the type's Claude environment key is the Secret Manager secret claude-env-gis.

# Job resources. Scratch is the Cloud Run ephemeral disk mounted at /scratch;
# 10 GiB is the default per-instance quota (no approval needed). gis wants
# 100 GiB for imagery and point clouds, once the quota is raised
# (ephemeral_disk_per_instance_gib in lolay/infrastructure; may need Google).
# Memory bounds gis work (rasters, point clouds, xarray), not CPU. 32 GiB is
# Cloud Run's most, and it needs 8 vCPU; past it, gis moves to Compute Engine.
CPU=8
MEMORY=32Gi
SCRATCH_GIB=10

# Cloud Run's hard stop for the execution: the 480 min session cap, plus up to
# 60 min a runner may wait unused, plus margin (9 h 30 min).
TASK_TIMEOUT_SEC=34200
# The runner retires (releases its session cleanly) this long before the hard stop.
RETIRE_MARGIN_SEC=900

# Orchestrator settings. No standby: a held 8 vCPU, 32 GiB execution is about
# $550 a month, so sessions wait for a cold start instead.
MIN_IDLE=0
EXPECTED_SPAWN_SECONDS=180

# Runner settings (images/shared/runners/claude.sh). Empty = never.
EXIT_IF_UNUSED_MIN=60
RELEASE_IDLE_SESSION_MIN=60
KILL_SESSION_AFTER_MIN=480

# The session notice shows its end time in this zone.
AGENT_NOTICE_TZ=America/Los_Angeles
