# The linux-gpu runner type: linux plus one NVIDIA GPU, a Cloud Run job,
# agent-linux-gpu, built from images/cloud/linux-gpu (linux's toolsets on CUDA's
# devel image, then the gpu toolset). One file per type; its name is the type.
# The deploy renders the job from it (scripts/cloud/job-spec.sh), and the
# orchestrator image bakes it in for the supervisor and the hook. Non-secret
# settings only: the type's Claude environment key is the Secret Manager secret
# claude-env-linux-gpu.

# The GPU: an RTX PRO 6000 with CPU=20 and MEMORY=80Gi, that GPU's minimums.
# m3 meant to test on an L4 first (cheaper), but Google denied the L4 quota and
# granted 2 RTX PRO 6000 (2000 milli GPU, us-central1, 2026-11-13;
# specs/handoffs/infra-ask-m3-gpu.md), so linux-gpu starts here. 100 GiB of
# scratch, within the 200 GiB per-instance ephemeral disk quota.
GPU_TYPE=nvidia-rtx-pro-6000
CPU=20
MEMORY=80Gi
SCRATCH_GIB=100
# A GPU job whose task timeout is over 1 hour is "Long running GPU jobs", still
# Preview (up to 12 hours): Cloud Run refuses the job unless it declares BETA
# (HTTP 400 on the first deploy, run 43381890855).
LAUNCH_STAGE=BETA

# Cloud Run's hard stop for the execution: the 480 min session cap, plus up to
# 60 min a runner may wait unused, plus margin (9 h 30 min).
TASK_TIMEOUT_SEC=34200
# The runner retires (releases its session cleanly) this long before the hard stop.
RETIRE_MARGIN_SEC=900

# Scheduled no-cache rebuild (specs/gcp.md, "Rebuild cadence"): nightly
# (Tuesday to Saturday) or weekly (Sunday). linux-gpu builds without the Actions
# cache anyway (CUDA is 4 GB of its 10), so a rebuild is a full one; Claude
# updates itself at runner start in between.
REBUILD=weekly

# Orchestrator settings. No standby: a held GPU execution bills the whole time.
# The image is about twice linux's (CUDA's devel image is 4 GB compressed), so
# the cold start will be longer than linux's 55 s; 300 until m3's first deploy
# measures it.
MIN_IDLE=0
EXPECTED_SPAWN_SECONDS=300

# Runner settings (images/shared/runners/claude.sh). Empty = never.
EXIT_IF_UNUSED_MIN=60
RELEASE_IDLE_SESSION_MIN=60
KILL_SESSION_AFTER_MIN=480

# The session notice shows its end time in this zone.
AGENT_NOTICE_TZ=America/Los_Angeles
