# The android runner type: a Compute Engine VM per session, from the image
# family agent-android (built by Packer from images/android/gce), because Cloud
# Run has no KVM for the emulator (specs/gcp.md, "Compute Engine VM per session").
# One file per type; its name is the type. The hook creates each VM from it, the
# orchestrator image bakes it in for the supervisor (and its reaper), and the
# deploy builds the image. Non-secret settings only: the type's Claude
# environment key is the Secret Manager secret claude-env-android.

# run (a Cloud Run job, the default) or compute (a VM per session).
BACKEND=compute

# The VM. Nested virtualization needs an Intel series (n2) or AMD n4d, never e2
# or Arm. The boot disk is the session's scratch too ($AGENT_SCRATCH=/scratch).
MACHINE_TYPE=n2-standard-8
DISK_GB=100
DISK_TYPE=pd-balanced
IMAGE_FAMILY=agent-android

# Compute Engine deletes the VM at this age whatever it's doing (maxRunDuration
# with instanceTerminationAction DELETE), and the reaper deletes any it finds past
# it: the 480 min session cap, plus up to 60 min a runner may wait unused, plus
# margin (9 h 30 min), as the Cloud Run types' task timeout.
MAX_RUN_DURATION_SEC=34200
# The runner retires (releases its session cleanly) this long before that.
RETIRE_MARGIN_SEC=900

# Orchestrator settings. No standby: an n2-standard-8 is about $0.40 an hour.
# The spawn estimate covers VM create, boot, and the runner's registration; set
# from the first deploy's measurement (m2.s7).
MIN_IDLE=0
EXPECTED_SPAWN_SECONDS=240

# Runner settings (images/shared/runners/claude.sh). Empty = never.
EXIT_IF_UNUSED_MIN=60
RELEASE_IDLE_SESSION_MIN=60
KILL_SESSION_AFTER_MIN=480
