# Packages installed into every macOS image. No versions on purpose: each build
# installs the current release, and a version gets pinned only when a release
# breaks something (see "Track the latest" in specs/design.md). README.md records
# what was current at the last lookup.
#
# Every tap listed here is trusted by install-packages.sh before the bundle runs.
tap "lolay/tap"

brew "age"
brew "asccli" # command is asccli; core's asc formula is a different tool
brew "gh"
brew "git"
brew "jq"
brew "ripgrep"
brew "sops"
brew "swiftformat"
brew "swiftlint"
brew "tmux"
brew "xcbeautify"
brew "xcodegen"
brew "lolay/tap/triage"

# Runner CLI. The runner script upgrades it at each start.
cask "claude-code@latest"
