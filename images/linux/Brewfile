# Homebrew formulae installed into every Linux image, after the apt packages in
# packages.txt. No versions, same policy (specs/design.md, "Track the latest"):
# each build installs the current release, so a session finds the toolchains
# ready instead of installing them (on Cloud Run, Homebrew is its only way to).
# install-packages.sh then installs the Rust and Terraform toolchains these
# managers fetch, and tflint, which Homebrew no longer carries.
#
# Every tap listed here is trusted by install-packages.sh before the bundle runs.
tap "lolay/tap"

# Node: pnpm from Homebrew, since Node 25 stopped bundling corepack.
brew "node"
brew "pnpm"

# Python: Homebrew's current 3.x ahead of Ubuntu's on PATH, and uv.
brew "python"
brew "uv"

# Go, and Rust through rustup (keg-only; PATH names its bin, which holds the
# cargo and rustc proxies).
brew "go"
brew "rustup"

# Protobuf and gRPC. Language plugins (protoc-gen-go, grpcio-tools,
# protoc-gen-es, tonic-build) are project dependencies, not image tools.
brew "protobuf"
brew "buf"
brew "grpcurl"

# Terraform through tenv, which reads a repo's .terraform-version (Homebrew
# dropped terraform after its license change).
brew "tenv"

# Lint.
brew "actionlint"
brew "shellcheck"

brew "lolay/tap/nowline"
brew "lolay/tap/triage"
