# Linux hosts: make init copies this to .env (macOS hosts get .env.example).
# .env is gitignored. Make syntax: KEY=value, no quotes, avoid "$" in values.

# The LXD image runner VMs launch from; make build publishes it.
IMAGE_REF=agent-linux

# Runner VMs. Each needs VM_MEMORY_GB free: 24 GB covers the emulator (4 GB),
# Gradle, and Claude, so a 64 GB host runs 2 and a 96 GB host 3.
RUNNER_MAX=2
# Standby VMs kept booted and registered (emulator up) so a new session starts at once.
RUNNER_MIN_IDLE=1
VM_CPU=6
VM_MEMORY_GB=24
# The orchestrator's /healthz port on this host.
ORCHESTRATOR_HEALTH_PORT=8080
# Runner labels in the Anthropic console (and guest hostnames) are
# <prefix>-runner-N. Default: this host's short hostname.
RUNNER_LABEL_PREFIX=

# make build: the base image and the build VM's size.
LINUX_BASE_IMAGE=ubuntu:24.04
BUILD_CPU=8
BUILD_MEMORY_GB=16
BUILD_DISK_GB=64

# make host-setup: the LXD ZFS pool's size in GB (a sparse file on /).
# Default: 70% of the free space on /.
LXD_POOL_GB=
