# The tools CI installs, at one version each: the one source every workflow
# reads (r1.f16, f17), so the macOS gate, the pull request check and the deploy
# can't drift apart. A step loads it with
#   scripts/cloud/github-env.sh scripts/ci/tools.env >>"$GITHUB_ENV"
# Renovate bumps each line through the comment above it (.github/renovate.json,
# customManagers); tests/unit/test_ci_tools.py checks every line has one.
#
# A Packer template's required_version is its floor, not this: every template's
# must accept PACKER_VERSION (test_ci_tools.py). shellcheck and shfmt come from
# scripts/ci/install-lint-tools.sh, which sources this file.

# renovate: datasource=github-releases depName=hashicorp/packer
PACKER_VERSION=1.16.2
# renovate: datasource=github-releases depName=koalaman/shellcheck
SHELLCHECK_VERSION=0.11.0
# renovate: datasource=github-releases depName=mvdan/sh
SHFMT_VERSION=3.14.1
