# Copy to vms/host.env (gitignored) for the host runner (make host-runner-run or
# host-runner-install), which runs sessions on this Mac itself, as you, for work
# a VM can't do (Apple Intelligence). Non-secret settings only: the registration
# secret comes from the host Keychain, account host-<fish context> or host
# (make secret-set NAME=claude-environment-secret VM=host). Use a self-hosted
# environment of its own, not the VM runners'. Other KEY=value lines reach every
# session as environment variables. bash sources this file, so $HOME works.

# Only this account's sessions are assigned to this runner. Empty = the account
# the context's Claude config directory is logged in to (oauthAccount.emailAddress
# in $CLAUDE_CONFIG_DIR/.claude.json). The host runner won't start without one.
CLAUDE_LOCK_TO_ACCOUNT=

# Must stay false on the host: the git proxy deletes ~/.gitconfig and
# ~/.config/git before every session, and --configure-git rewrites ~/.gitconfig.
# Sessions use your git config and SSH keys, and push as you.
CLAUDE_USE_GIT_PROXY=false
CLAUDE_CONFIGURE_GIT=false

# auto, true, or false: when the runner ends a session early (host restart,
# idle release, uninstall), push its committed work with your credentials so
# the session resumes from it. auto = on, since there's no git proxy.
CLAUDE_PUSH_OUTCOME_ON_RELEASE=auto

# Where repos are checked out. Clones stay between sessions; each session's
# worktree and state are removed when it ends.
CLAUDE_BASE_DIR=$HOME/agent-host-workspace

# Release a session after this many minutes with no user input, so it doesn't
# hold the host's one runner; it resumes at the next message on a free runner.
# Empty = never.
CLAUDE_RELEASE_IDLE_SESSION_MIN=60

# Cap a session's life (runaway backstop). Empty = never.
CLAUDE_KILL_SESSION_AFTER_MIN=480

# enforce, warn, or off: refuse repos whose committed .claude settings grant
# writes outside the workspace.
CLAUDE_CONFINE_REPO_SETTINGS=enforce
