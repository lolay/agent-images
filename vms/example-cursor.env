# Copy to vms/<vm>.env (gitignored) and edit. Non-secret settings only:
# secrets come from the host Keychain (make secret-set). VM names must be
# letters, digits, and hyphens; they become the guest's hostname.
AGENT=cursor

# The repo this worker serves. For a multi-repo project, point at the
# workspace repo and let sessions clone siblings (needs the git-token secret).
CURSOR_REPOSITORY_URL=https://github.com/your-org/nowline-workspace.git

# Optional branch or tag to check out in the worker directory.
CURSOR_REF=

# Team pools: set a pool name and use a service account key.
# Empty = My Machines (individual plans).
CURSOR_POOL_NAME=
CURSOR_IDLE_RELEASE_TIMEOUT=600
