# Copy to vms/<vm>.env (gitignored) and edit. Non-secret settings only:
# secrets come from the host Keychain (make secret-set). VM names must be
# letters, digits, and hyphens; they become the guest's hostname.
AGENT=claude

# Optional: only this account's sessions are assigned to this runner.
CLAUDE_LOCK_TO_ACCOUNT=

# true = Anthropic-managed git auth (no git credentials on the VM).
CLAUDE_USE_GIT_PROXY=true
