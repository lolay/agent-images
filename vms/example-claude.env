# Copy to vms/runner.env (gitignored) for every orchestrator runner VM, or to
# vms/<vm>.env for a debug VM from make vm-up. Non-secret settings only: the
# registration secret comes from the host Keychain (make secret-set). Other
# KEY=value lines reach every session as environment variables, like a cloud
# environment's variables, so never put secrets here.
AGENT=claude

# Optional: only this account's sessions are assigned to this runner.
CLAUDE_LOCK_TO_ACCOUNT=

# true = Anthropic-managed git auth (no git credentials on the VM).
CLAUDE_USE_GIT_PROXY=true

# auto, true, or false: when the runner ends a session early (watchdog, host
# restart, idle release), push its committed work so the session resumes from
# it. auto = on only when CLAUDE_USE_GIT_PROXY is false: the release-time push
# needs git credentials on the VM, and with the proxy there are none (the Stop
# hook asks Claude to push instead).
CLAUDE_PUSH_OUTCOME_ON_RELEASE=auto

# true = git identity Claude <noreply@anthropic.com> and Anthropic commit
# signing (the image has no git identity of its own).
CLAUDE_CONFIGURE_GIT=true

# Release a session after this many minutes with no user input, so it doesn't
# hold one of the host's VMs; it resumes on a fresh VM at the next message.
# Empty = never.
CLAUDE_RELEASE_IDLE_SESSION_MIN=60

# Cap a session's life (runaway backstop). Empty = never.
CLAUDE_KILL_SESSION_AFTER_MIN=480

# enforce, warn, or off: refuse repos whose committed .claude settings grant
# writes outside the workspace.
CLAUDE_CONFINE_REPO_SETTINGS=enforce

# Git proxy watchdog (anthropics/claude-code#96856): log, or terminate to stop
# the runner so the session requeues onto a fresh VM.
WATCHDOG_ACTION=log
