# Copy to .env (make init does this) and fill in. .env is gitignored.
# Make syntax: KEY=value, no quotes, avoid "$" in values.

# Private OCI registry for make publish, e.g. ghcr.io/your-org
REGISTRY=

# Run hosts: the image to clone. A local name after make build, or a registry
# reference such as ghcr.io/your-org/agent-macos:v0.1.0
IMAGE_REF=agent-macos

# Run hosts: runner VMs. At most two macOS VMs run per host (Apple's limit).
RUNNER_MAX=2
# Standby VMs kept booted and registered so a new session starts at once.
RUNNER_MIN_IDLE=1
VM_CPU=4
VM_MEMORY_GB=12
# The orchestrator's /healthz port on this host.
ORCHESTRATOR_HEALTH_PORT=8080
# Runner labels in the Anthropic console (and guest hostnames) are
# <prefix>-runner-N, and <prefix>-host for the host runner. Default: this Mac's
# LocalHostName.
RUNNER_LABEL_PREFIX=

# Host runner (make host-runner-*): a runner on this Mac itself, not a VM.
# Its /healthz port, apart from the orchestrator's.
HOST_RUNNER_HEALTH_PORT=8081
# Its Claude config directory: seeded into every session, and its logged-in
# account is the one the runner is locked to. Empty = CLAUDE_CONFIG_DIR if your
# shell sets it, else ~/.claude. Use ~/ or an absolute path, not $HOME. Also
# settable per run: make host-runner-install HOST_CLAUDE_CONFIG_DIR=~/.claude-work
HOST_CLAUDE_CONFIG_DIR=
# The shell that sets up the runner's environment. Default: your login shell.
HOST_RUNNER_SHELL=
