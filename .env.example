# Copy to .env (make init does this) and fill in. .env is gitignored.
# Make syntax: KEY=value, no quotes, avoid "$" in values.

# Build hosts only. Password for the agent user, also written to /etc/kcpassword
# in the image for automatic login, so don't reuse a real password.
PKR_VAR_user_password=change-me

# Private OCI registry for make publish, e.g. ghcr.io/your-org
REGISTRY=

# Run hosts: the image to clone. A local name after make build, or a registry
# reference such as ghcr.io/your-org/agent-macos:v0.1.0
IMAGE_REF=agent-macos
